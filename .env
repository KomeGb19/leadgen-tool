# FMCSA — free, get a webKey at https://mobile.fmcsa.dot.gov (sign in via Login.gov).
# Without it, /api/enrich still discovers companies via Google Places but skips
# FMCSA fleet-size verification.
FMCSA_WEBKEY=e0097e240b278fa528c759308950aecb259be0cb

# Google Places (New) — for company discovery. Enable "Places API (New)" in
# Google Cloud Console and restrict the key to that API.
GOOGLE_PLACES_API_KEY=AIzaSyC8CtZPacNBAzkfcxCZP6tTimfG6kfWzks

# Google Static Maps — for server-generated satellite thumbnails stored per lead.
# Can reuse GOOGLE_PLACES_API_KEY if it's unrestricted, but a separate
# restricted key is safer.
GOOGLE_MAPS_STATIC_API_KEY=AIzaSyBDgHfLn3szjQjpmUJO_Pz9IVeU9ndR6oY

# Same key as above but exposed to the browser, so the Satellite tab in the
# lead detail panel can fetch live tiles at any zoom without a server round trip.
# Restrict this key to the Maps Static API + your domain's HTTP referrers.
